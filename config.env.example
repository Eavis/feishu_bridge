# Feishu Bridge (hybrid) Configuration
# Copy to config.env in the project root and edit.

# ── Default workspace ──
# Default working directory for agent sessions (where files Claude/Copilot read,
# write, and send back via the feishu-outbox MCP server live).
CTI_DEFAULT_WORKDIR=C:\projects

# ── Backend agent ──
# Which coding-agent backend to use by default for new chat bindings.
# Per-chat override via /agent <claude|copilot|codex|eureka> in Feishu.
#   claude    — in-process @anthropic-ai/claude-agent-sdk (requires `claude` CLI installed+logged-in)
#   copilot   — spawns `node @github/copilot/npm-loader.js -p ...` subprocess (requires `copilot` CLI installed+logged-in)
#   codex     — spawns `codex exec --json` through CTI_CODEX_BASE_URL proxy config
#   eureka    — creates/resumes Eureka desktop tasks through the local MCP endpoint
CTI_DEFAULT_AGENT=claude

# ── Model ──
# Pin a specific model. Empty = let each backend pick its default.
# For Claude: a Claude model alias like "claude-opus-4-7" / "claude-sonnet-4-6"
# For Copilot: a Copilot model id like "claude-opus-4.8" / "auto"
# (NOTE: this pin applies to BOTH backends if set, so prefer leaving blank
#  unless you only ever use one agent.)
# CTI_DEFAULT_MODEL=

# Default chat mode (code, plan, ask)
CTI_DEFAULT_MODE=code

# ── Agent CLI paths (optional overrides) ──
# Override only if the daemon picks the wrong binary.
# CTI_CLAUDE_CODE_EXECUTABLE=/path/to/claude
# CTI_COPILOT_EXECUTABLE=/path/to/copilot
# CTI_CODEX_EXECUTABLE=/path/to/codex

# Codex session/config root override (default: ~/.codex)
# CODEX_HOME=/path/to/.codex
# Stable home used by the bridge for new Codex threads. Inherited CODEX_HOME
# values from a parent Eureka task are intentionally ignored for new threads.
# CTI_CODEX_HOME=C:/Users/you/.codex
# Optional extra Eureka installation roots (`;` separated on Windows, `:` on Unix)
# CTI_EUREKA_ROOTS=C:\Users\me\.eureka

# ── Eureka desktop provider ──
# CTI_EUREKA_MCP_URL=http://127.0.0.1:21900/mcp
# Optional underlying engine/model selection; omit to use Eureka workspace defaults.
# CTI_EUREKA_AGENT_ENGINE=codex                # claude | codex | copilot | pi
# CTI_EUREKA_THINKING_LEVEL=think              # off | think | max
# CTI_EUREKA_ENABLED_SOURCES=source-a,source-b
# CTI_EUREKA_TURN_TIMEOUT_MS=1800000
# CTI_EUREKA_CALLER_SESSION_ID=                # normally unnecessary

# ── Unattended reliability ──
# Fixed loopback health/dashboard port used by the Windows watchdog.
# CTI_OUTBOX_PORT=59991
# Deadline for every Feishu HTTP request, including token acquisition/downloads.
# CTI_FEISHU_REQUEST_TIMEOUT_MS=30000
# Abort a provider that never emits its first event, goes silent mid-turn, or
# exceeds the absolute ceiling. Values are milliseconds.
# CTI_AGENT_FIRST_EVENT_TIMEOUT_MS=120000
# CTI_AGENT_IDLE_TIMEOUT_MS=600000
# CTI_AGENT_MAX_TURN_TIMEOUT_MS=7200000

# ── Codex proxy provider (required for codex backend) ──
# Codex is forced through this OpenAI-compatible Responses proxy and will not
# silently fall back to ChatGPT/Codex account quota.
# CTI_CODEX_BASE_URL=http://localhost:5000
# CTI_CODEX_AUTH_ENV_KEY=ANTHROPIC_AUTH_TOKEN
# CTI_CODEX_PROVIDER_NAME=LLM Proxy

# ── Third-party Anthropic API provider (optional, claude backend only) ──
# Set these so the SDK forwards them to its subprocess if you proxy Claude.
# ANTHROPIC_API_KEY=your-api-key
# ANTHROPIC_BASE_URL=https://api.example.com/v1
# ANTHROPIC_AUTH_TOKEN=your-auth-token

# ── Feishu / Lark ──
CTI_FEISHU_APP_ID=your-app-id
CTI_FEISHU_APP_SECRET=your-app-secret
# Domain: feishu (default) or lark
CTI_FEISHU_DOMAIN=feishu
# Restrict access to specific user/chat IDs (comma-separated, empty = allow all)
# CTI_FEISHU_ALLOWED_USERS=user_id_1,user_id_2
# Require @mention in group chats (default: true). Set false to reply on every
# group message — requires the im:message.group_msg scope on the Feishu app.
CTI_FEISHU_REQUIRE_MENTION=true

# ── Permission ──
# Auto-approve all tool permission requests without user confirmation.
# Note: copilot backend always runs --allow-all-tools (non-interactive constraint),
# so this flag only meaningfully gates the claude backend.
# ⚠️  Only enable this in trusted, access-controlled environments.
# CTI_AUTO_APPROVE=true
