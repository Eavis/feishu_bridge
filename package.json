{
  "name": "feishu-bridge-hybrid",
  "version": "0.1.0",
  "description": "Feishu/Lark ↔ local coding agent bridge with switchable backend (Claude Code, GitHub Copilot, Codex, or Eureka), durable cron, fork-chat, and outbox MCP server",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node dist/daemon.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/main.ts",
    "test": "tsx --test src/__tests__/unit.test.ts src/__tests__/eureka-provider.unit.test.ts src/__tests__/reliability.test.ts",
    "test:watchdog": "powershell.exe -NoProfile -NonInteractive -File scripts/test-windows-watchdog.ps1",
    "test:integration": "tsx --test src/__tests__/feishu-api.test.ts src/__tests__/integration.test.ts",
    "test:eureka-real": "tsx --test src/__tests__/eureka-provider.integration.test.ts",
    "test:codex-real": "tsx --test src/__tests__/codex-provider.integration.test.ts",
    "test:e2e": "tsx --test src/__tests__/eureka-feishu.e2e.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.62",
    "@larksuiteoapi/node-sdk": "1.74.0",
    "cron-parser": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
